{
  "alert": "Sonarr is down",
  "alertType": "METRIC_BASED_ALERT",
  "ruleType": "threshold_rule",
  "description": "Sonarr has failed its HTTP health check for 5 minutes straight. TV automation is down.",
  "evalWindow": "5m",
  "frequency": "1m",
  "version": "v5",
  "condition": {
    "compositeQuery": {
      "queryType": "builder",
      "panelType": "graph",
      "queries": [
        {
          "type": "builder_query",
          "spec": {
            "name": "A",
            "signal": "metrics",
            "stepInterval": "1m",
            "filter": {
              "expression": "probe.service = 'sonarr' AND http.status_class = '2xx'"
            },
            "aggregations": [
              {
                "metricName": "httpcheck.status",
                "temporality": "unspecified",
                "timeAggregation": "min",
                "spaceAggregation": "min"
              }
            ]
          }
        }
      ]
    },
    "op": "2",
    "target": 1.0,
    "matchType": "2",
    "selectedQueryName": "A"
  },
  "labels": {
    "severity": "warning",
    "service": "sonarr"
  },
  "annotations": {
    "summary": "Sonarr is not responding",
    "description": "TV automation is down."
  },
  "preferredChannels": [
    "default"
  ]
}
