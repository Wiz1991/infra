      "isStacked": false,
      "nullZeroValues": "zero",
      "opacity": "1",
      "softMax": null,
      "softMin": null,
      "thresholds": [],
      "timePreferance": "GLOBAL_TIME",
      "query": {
        "queryType": "builder",
        "builder": {
          "queryData": [
            {
              "aggregations": [
                {
                  "metricName": "system.cpu.time",
